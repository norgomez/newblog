---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About">
	<div class="prose" style="padding-top: 1.5rem;">
		<h2 style="margin-top: 0;">About</h2>
		<p>
			Hi — I'm an engineer who likes to write about the things I build and the
			things I learn along the way. This blog is where those notes live.
		</p>
		<p>
			Expect posts about software design, tooling, debugging war stories, and
			the occasional deep dive into how something works under the hood.
		</p>
		<p>
			<em>
				This page is a placeholder — edit
				<code>src/pages/about.astro</code> to make it yours.
			</em>
		</p>
	</div>
</BaseLayout>
