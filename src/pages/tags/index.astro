---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allPosts, tagIndex } from '../../lib/posts';

const posts = await allPosts();
const tags = tagIndex(posts);
---

<BaseLayout
	title="Topics"
	description="Every topic covered on the blog, from electricity and motors to chips and control systems."
>
	<header class="page-header">
		<h1>Topics</h1>
		<p class="meta">{tags.length} topics across {posts.length} posts</p>
	</header>

	<p class="intro" style="border-bottom: 0; padding-bottom: 0.5rem;">
		Most posts sit under more than one. Pick a thread and pull.
	</p>

	<ul class="tag-cloud">
		{
			tags.map(({ tag, count }) => (
				<li>
					<a class="tag-chip tag-chip-lg" href={`/tags/${tag}/`}>
						{tag}
						<span class="tag-count">{count}</span>
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>
