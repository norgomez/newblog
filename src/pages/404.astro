---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
	<div class="notfound">
		<p class="meta">404</p>
		<h1>Page not found</h1>
		<p>
			This page doesn't exist — or it drifted out of its lane and no feedback
			loop corrected it.
		</p>
		<p><a class="back-link" href="/">← Back to all writing</a></p>
	</div>
</BaseLayout>
