---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION } from '../consts';
import { allPosts, seriesIndex } from '../lib/posts';

const posts = await allPosts();

const seriesBlurbs: Record<string, string> = {
	'Maker Basics':
		'Electronics from first principles — electricity, communication, microcontrollers, sensing, motion, and making things.',
	'Under the Hood':
		'How cars actually work — the control loops, the machinery, and why electric drivetrains delete half of it.',
	'Inside the Machine':
		'The hardware AI actually runs on — from a single switch up to a datacenter, and why moving numbers costs more than crunching them.',
};

const seriesCards = seriesIndex(posts).map(({ name, posts: parts }) => ({
	name,
	blurb: seriesBlurbs[name] ?? '',
	count: parts.length,
	first: parts[0],
}));
---

<BaseLayout>
	<p class="intro">{SITE_DESCRIPTION}</p>

	<section class="start-here">
		<p class="meta">Start here</p>
		<div class="series-cards">
			{
				seriesCards.map(({ name, blurb, count, first }) => (
					<a class="series-card" href={`/blog/${first.id}/`}>
						<span class="series-card-title">{name}</span>
						<span class="series-card-blurb">{blurb}</span>
						<span class="meta">{count} parts · begin with part 1 →</span>
					</a>
				))
			}
		</div>
	</section>

	<p class="meta section-label">
		All writing · <a href="/tags/">browse by topic</a>
	</p>
	<PostList posts={posts} />
</BaseLayout>
